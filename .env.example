# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=
MAX_SPEND_USD=40
NESSIE_API_KEY=
# LIVE | MOCK | OFFLINE
MODE=MOCK
DATABASE_PATH=./data/signet.db

# Optional model overrides (see: npm run models)
CLAUDE_HAIKU_MODEL=claude-haiku-4-5
# CLAUDE_SONNET_MODEL=
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_ZONE=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX=signet-memory

# CRS Credit API (StitchCredit sandbox) - vendor identity via FraudFinder. Use ONLY sandbox test personas.
CRS_BASE_URL=https://api-sandbox.stitchcredit.com/api
CRS_API_USERNAME=
CRS_API_PASSWORD=
